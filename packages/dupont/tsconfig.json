{
  // Package-local strict typecheck, self-contained (no root tsconfig is required: the
  // bitget-trading-sim repo root has none). `@bitget-sim/shared` is only used for TYPE imports
  // (Candle, PublicTrade), so it is mapped to its types module here to keep this check
  // independent of unrelated pre-existing errors elsewhere in shared.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@bitget-sim/shared": ["../shared/src/types.ts"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
